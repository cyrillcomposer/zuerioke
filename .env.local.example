# Copy this file to .env.local and fill in real values for local development.
# .env.local is gitignored — never commit real secrets.

# From Vercel dashboard → Storage → Upstash Redis integration
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared password for /sing-admin (your own choice)
SING_ADMIN_PASSWORD=
